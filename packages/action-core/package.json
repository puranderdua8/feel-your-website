{
  "name": "@feel-your-website/action-core",
  "version": "0.0.0",
  "private": true,
  "description": "The registered-actions vocabulary: one catalog of pre-approved external HTTP endpoints (query + mutation), the ActionInvoker interface, and the cache-store seam.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "@feel-your-website/config": "workspace:*",
    "@feel-your-website/content-core": "workspace:*",
    "@types/node": "^22.10.5",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
