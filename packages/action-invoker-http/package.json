{
  "name": "@feel-your-website/action-invoker-http",
  "version": "0.0.0",
  "private": true,
  "description": "The HTTP ActionInvoker: runs a catalog action against its env-configured upstream, applies the timeout, and normalises the response. Bound only at the shell's DI seam.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude '**/contract.test.ts'",
    "test:contracts": "vitest run src/contract.test.ts",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@feel-your-website/action-core": "workspace:*",
    "@feel-your-website/content-core": "workspace:*"
  },
  "devDependencies": {
    "@feel-your-website/action-registry": "workspace:*",
    "@feel-your-website/config": "workspace:*",
    "@types/node": "^22.10.5",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
