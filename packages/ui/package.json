{
  "name": "@feel-your-website/ui",
  "version": "0.0.0",
  "private": true,
  "description": "The component library. Vendored into this repo rather than published, because the boilerplate is cloned per project.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
