    "tailwind-merge": "^2.6.0",
    "vaul": "^1.1.2"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@feel-your-website/config": "workspace:*",
