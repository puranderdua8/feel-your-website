{
  "name": "@feel-your-website/analytics-ga",
  "version": "0.1.0",
  "private": true,
  "description": "GoogleAnalytics 4 adapter for @feel-your-website/analytics-core: loads gtag.js, maps the event envelope, Consent Mode v2.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:contracts": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@feel-your-website/analytics-core": "workspace:*"
  },
  "devDependencies": {
    "@feel-your-website/config": "workspace:*",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
